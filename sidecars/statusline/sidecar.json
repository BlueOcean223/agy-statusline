{
  "command": "/bin/sh",
  "args": ["-c", "exec ../../bin/agy-ccline sidecar"],
  "restart_policy": "always",
  "display_name": "Statusline",
  "description": "CCometixLine-inspired native telemetry & statusline pane for context, cache hit rate, cost, TPS, subagents, and 5h/7d quotas.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Statusline",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Statusline"
      }
    ]
  }
}
